# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI (LLM calls for the Router, Knowledge, Support and Escalation agents)
OPENAI_API_KEY=

# Pinecone (vector store for the Knowledge Agent's RAG pipeline)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Tavily (web search fallback for out-of-scope knowledge questions)
TAVILY_API_KEY=

# Optional overrides (defaults shown)
# ROUTER_MODEL=gpt-4o-mini
# KNOWLEDGE_MODEL=gpt-4o-mini
# SUPPORT_MODEL=gpt-4o-mini
# ESCALATION_MODEL=gpt-4o-mini
# DATA_DIR=data_store
